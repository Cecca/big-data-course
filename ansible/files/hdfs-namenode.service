[Unit]
Description=Apache Hadoop HDFS namenode
After=network.target

[Service]
Type=forking
User=hadoop
Group=hadoop
ExecStart=/opt/hadoop/sbin/hadoop-daemon.sh --config /opt/hadoop/etc/hadoop/ --script /opt/hadoop/bin/hdfs start namenode
ExecStop=/opt/hadoop/sbin/hadoop-daemon.sh --config /opt/hadoop/etc/hadoop/ --script /opt/hadoop/bin/hdfs stop namenode

[Install]
WantedBy=multi-user.target